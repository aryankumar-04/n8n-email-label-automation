# ==============================================================================
# NOTE: Credentials for n8n workflows should be created directly inside the n8n
# web interface (Credentials > Add Credential) and are NEVER stored in this repository.
#
# This file serves as a reference for environment variables if you are running n8n
# via Docker or using custom environment injections.
# ==============================================================================

# NVIDIA NIM API Key (Obtain from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# (Optional) Google OAuth2 Client Configuration if self-hosting OAuth redirect
GMAIL_OAUTH_CLIENT_ID=your_gmail_client_id_here
GMAIL_OAUTH_CLIENT_SECRET=your_gmail_client_secret_here
